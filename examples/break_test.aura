class Program {
    static void Main() {
        // Simple break test
        int count = 0;
        for (int i = 0; i < 10; i = i + 1) {
            if (i == 5) {
                break;
            }
            count = count + 1;
        }
        print("Count: ");
        print(count);
        println();
    }
}
