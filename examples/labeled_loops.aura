class Program {
    static void Main() {
        print("=== Testing labeled break/continue ===");
        println();
        
        // Test 1: Labeled break in nested loops
        print("Test 1: Labeled break");
        println();
        outer: for (int i = 0; i < 3; i = i + 1) {
            for (int j = 0; j < 3; j = j + 1) {
                if (i == 1 && j == 1) {
                    break outer;
                }
                print("i=");
                print(i);
                print(", j=");
                print(j);
                println();
            }
        }
        println();
        
        // Test 2: Labeled continue in nested loops
        print("Test 2: Labeled continue");
        println();
        outer2: for (int i = 0; i < 3; i = i + 1) {
            for (int j = 0; j < 3; j = j + 1) {
                if (j == 1) {
                    continue outer2;
                }
                print("i=");
                print(i);
                print(", j=");
                print(j);
                println();
            }
        }
        println();
        
        // Test 3: Unlabeled break (innermost loop)
        print("Test 3: Unlabeled break");
        println();
        for (int i = 0; i < 2; i = i + 1) {
            for (int j = 0; j < 3; j = j + 1) {
                if (j == 1) {
                    break;
                }
                print("i=");
                print(i);
                print(", j=");
                print(j);
                println();
            }
        }
        println();
        
        // Test 4: Unlabeled continue (innermost loop)
        print("Test 4: Unlabeled continue");
        println();
        for (int i = 0; i < 2; i = i + 1) {
            for (int j = 0; j < 3; j = j + 1) {
                if (j == 1) {
                    continue;
                }
                print("i=");
                print(i);
                print(", j=");
                print(j);
                println();
            }
        }
        println();
        
        print("All tests completed!");
        println();
    }
}
