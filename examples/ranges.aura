class Program {
    static void Main() {
        print("Exclusive range 1..5:");
        println();
        for (int i in 1..5) {
            print(i);
            print(" ");
        }
        println();

        print("Inclusive range 1..=5:");
        println();
        for (int i in 1..=5) {
            print(i);
            print(" ");
        }
        println();

        print("Range with expressions 2+1..2*3:");
        println();
        for (int i in 2+1..2*3) {
            print(i);
            print(" ");
        }
        println();

        print("Nested ranges:");
        println();
        for (int i in 1..=3) {
            for (int j in 1..=3) {
                print(i);
                print("*");
                print(j);
                print("=");
                print(i * j);
                print(" ");
            }
            println();
        }
    }
}
